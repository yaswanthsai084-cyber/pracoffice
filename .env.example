# PracOffice - Docker Compose configuration.
#
# Copy this file to `.env` (git-ignored) and adjust. `docker compose` reads the
# root `.env` automatically and substitutes the values into docker-compose.yml.
#
# The ONLYOFFICE entry matters most: JWT_SECRET must be identical on the
# document server and on the backend, or every editor config is rejected with
#
#   "The document security token is not correctly formed.
#    Please contact your Document Server administrator."
#
# The compose file passes this same value to BOTH services, so keeping it here
# is enough when the whole stack runs under Compose.

# --- database --------------------------------------------------------------
DB_NAME=pracoffice
DB_USER=postgres
DB_PASSWORD=postgres

# --- application -----------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string

# --- ONLYOFFICE Docs -------------------------------------------------------
# Must equal OFFICE_JWT_SECRET in backend/.env when the backend runs on the
# host (./dev.sh) instead of in Compose.
OFFICE_JWT_SECRET=change-me-to-a-long-random-string

# How the BROWSER reaches the document server.
OFFICE_PUBLIC_URL=http://localhost:8080
