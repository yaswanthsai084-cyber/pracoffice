# ---------------------------------------------------------------------------
# PracOffice backend configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Comma separated list of allowed origins, or * for all (development default).
CORS_ORIGIN=http://localhost:5173

# --------------------------- authentication --------------------------------
# Min 16 characters. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_ISSUER=pracoffice
BCRYPT_SALT_ROUNDS=10

# --------------------------- database (PLAN.md) ----------------------------
# The whole database connection (host, port, name, user, password) is read
# from THIS file - nothing about the connection is hardcoded in the source.
#
# DB_DIALECT: postgres | sqlite
#   postgres -> uses the DB_* connection details below
#   sqlite   -> local file (or :memory:), no server required
# Leave DB_DIALECT empty to auto-detect: PostgreSQL as soon as DB_HOST /
# DB_NAME / DATABASE_URL is filled in, otherwise the SQLite fallback.
DB_DIALECT=sqlite

# --- PostgreSQL connection details -----------------------------------------
# Set DB_DIALECT=postgres above to use these.
# The database named in DB_NAME is created automatically on first connect
# when the PostgreSQL role is allowed to create databases.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_portal
DB_USER=postgres
DB_PASSWORD=2205
# Managed hosts (Neon, Supabase, Render, Railway, ...) require SSL.
DB_SSL=false

# Alternative to the five variables above - a single connection string that
# overrides them when present:
# DATABASE_URL=postgres://pracoffice:secret@localhost:5432/pracoffice

# --- SQLite fallback (used when DB_DIALECT=sqlite) -------------------------
# Defaults to backend/data/pracoffice.<env>.sqlite when empty.
# Use :memory: for a throwaway database.
DB_STORAGE=

# Log every generated SQL statement.
DB_LOGGING=false
# Run sequelize.sync({ alter: true }) on boot (development only).
DB_SYNC_ALTER=false
# Maximum accepted JSON body size.
JSON_LIMIT=2mb
