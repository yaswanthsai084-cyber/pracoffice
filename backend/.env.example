# ---------------------------------------------------------------------------
# PracOffice backend configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Comma separated list of allowed origins, or * for all (development default).
CORS_ORIGIN=http://localhost:5173

# --------------------------- authentication --------------------------------
# Min 16 characters. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_ISSUER=pracoffice
BCRYPT_SALT_ROUNDS=10

# --------------------------- database (PLAN.md) ----------------------------
# The whole database connection (host, port, name, user, password) is read
# from THIS file - nothing about the connection is hardcoded in the source.
#
# DB_DIALECT: postgres | sqlite
#   postgres -> uses the DB_* connection details below
#   sqlite   -> local file (or :memory:), no server required
# Leave DB_DIALECT empty to auto-detect: PostgreSQL as soon as DB_HOST /
# DB_NAME / DATABASE_URL is filled in, otherwise the SQLite fallback.
DB_DIALECT=sqlite

# --- PostgreSQL connection details -----------------------------------------
# Set DB_DIALECT=postgres above to use these.
# The database named in DB_NAME is created automatically on first connect
# when the PostgreSQL role is allowed to create databases.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=exam_portal
DB_USER=postgres
DB_PASSWORD=2205
# Managed hosts (Neon, Supabase, Render, Railway, ...) require SSL.
DB_SSL=false

# Alternative to the five variables above - a single connection string that
# overrides them when present:
# DATABASE_URL=postgres://pracoffice:secret@localhost:5432/pracoffice

# --- SQLite fallback (used when DB_DIALECT=sqlite) -------------------------
# Defaults to backend/data/pracoffice.<env>.sqlite when empty.
# Use :memory: for a throwaway database.
DB_STORAGE=

# Log every generated SQL statement.
DB_LOGGING=false
# Run sequelize.sync({ alter: true }) on boot (development only).
DB_SYNC_ALTER=false
# Maximum accepted JSON body size.
JSON_LIMIT=2mb

# ------------------------- office document server --------------------------
# ONLYOFFICE Docs provides the real Word / Excel / PowerPoint editors.
# OPTIONAL: with OFFICE_ENABLED=false the frontend uses its built-in editor
# instead and practical tasks are marked by an examiner.
#
# Start the document server first:
#   docker compose up -d onlyoffice
# then point these at it and set OFFICE_ENABLED=true.
OFFICE_ENABLED=false
# How the BROWSER reaches the document server (loads api.js from here).
OFFICE_PUBLIC_URL=http://localhost:8080
# How the BACKEND reaches the command service for forced checkpoints
# (`Next` / `Submit`). Same host-local default; use http://onlyoffice under
# Compose, where localhost inside backend is backend itself.
OFFICE_COMMAND_URL=http://localhost:8080
# How the DOCUMENT SERVER reaches THIS API. It runs in Docker, so "localhost"
# would mean the container itself. Use the docker0 gateway on Linux when the
# backend runs on the host (./dev.sh), or the service name under Compose:
#   host + Docker -> http://172.17.0.1:3000
#   docker compose -> http://backend:3000
OFFICE_INTERNAL_URL=
OFFICE_JWT_ENABLED=true

# MUST BE IDENTICAL TO THE DOCUMENT SERVER'S JWT_SECRET.
# A mismatch shows up in the browser as:
#   "The document security token is not correctly formed.
#    Please contact your Document Server administrator."
# It makes the document server reject every editor config (and every callback).
#
# Which value to use depends on how the container was started:
#   docker run   -e JWT_SECRET=<value> ...   -> use <value> here
#   docker compose up -d onlyoffice          -> the compose file passes
#                                               OFFICE_JWT_SECRET from the root
#                                               .env (see .env.example)
#
# To confirm the container's value:
#   sudo docker inspect onlyoffice --format '\{\{.Config.Env\}\}' | tr ' ' '\n' | grep JWT_SECRET
# Then restart this API (the value is read once at boot).
OFFICE_JWT_SECRET=change-me-to-a-long-random-string

# Where each student's working copies are written. Defaults to
# backend/data/office/<userId>/<part>/document.<ext>.
OFFICE_STORAGE_DIR=
