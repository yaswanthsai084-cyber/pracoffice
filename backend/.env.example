# ---------------------------------------------------------------------------
# PracOffice backend configuration. Copy to `.env` and adjust.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Comma separated list of allowed origins, or * for all (development default).
CORS_ORIGIN=http://localhost:5173

# --------------------------- authentication --------------------------------
# Min 16 characters. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_ISSUER=pracoffice
BCRYPT_SALT_ROUNDS=10

# --------------------------- database (PLAN.md) ----------------------------
# postgres | sqlite. Leave empty to auto-detect: PostgreSQL when DATABASE_URL /
# DB_NAME / DB_HOST is present, otherwise the SQLite fallback (dev + tests).
DB_DIALECT=

# PostgreSQL (preferred, per PLAN.md) - uncomment to use it:
# DATABASE_URL=postgres://pracoffice:secret@localhost:5432/pracoffice
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pracoffice
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# SQLite fallback (used when DB_DIALECT=sqlite / no PostgreSQL config).
# Use :memory: for throwaway databases.
DB_STORAGE=

# Log every generated SQL statement.
DB_LOGGING=false
# Run sequelize.sync({ alter: true }) on boot (development only).
DB_SYNC_ALTER=false
# Maximum accepted JSON body size.
JSON_LIMIT=2mb
