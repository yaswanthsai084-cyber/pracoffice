{
  "name": "@unlayer/types",
  "version": "1.503.0",
  "license": "MIT",
  "private": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts"
    },
    "./editor/*": {
      "types": "./dist/editor/*.d.ts"
    },
    "./containers": {
      "types": "./dist/containers/index.d.ts"
    },
    "./containers/*": {
      "types": "./dist/containers/*.d.ts"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts"
    },
    "./tools/*": {
      "types": "./dist/tools/*.d.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist __generated__",
    "gen-translation-types": "node scripts/gen-translation-types.js",
    "prebuild": "pnpm run clean && pnpm run gen-translation-types && pnpm run build:legacy-unlayer-types",
    "build": "node scripts/build-types.js && node scripts/build-values-types.js",
    "prebuild:legacy-unlayer-types": "pnpm run clean",
    "build:legacy-unlayer-types": "cd ../../packages/editor/src/embed; pnpm exec tsc > /dev/null; cd ../../../../packages/unlayer-types; mkdir -p ../../packages/unlayer-types/__generated__/; cp -r ../../packages/editor/src/embed/__generated__/embed.d.ts ../../packages/unlayer-types/__generated__/legacy-unlayer-types.d.ts",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "node scripts/test-types.js",
    "test:unit": "pnpm exec jest --runInBand",
    "typecheck": "pnpm run build && tsc --noEmit --project tests/tsconfig.json",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "jest": "29.7.0",
    "@types/jest": "29.5.13",
    "ts-jest": "29.4.11"
  }
}
