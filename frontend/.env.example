# Practice-document URLs shown inline on the exam page.
#
# IMPORTANT: each value MUST be a document link readable WITHOUT signing in -
# shared in OneDrive/SharePoint as "Anyone with the link". The URLs from
# "Open in Word" (word.cloud.microsoft/open/onedrive/?docId=...) are
# sign-in-protected app routes: the Office Online viewer cannot fetch them and
# answers "the document is not publicly accessible", so the exam falls back to
# the built-in editor instead.
VITE_WORD_DOC_URL=
VITE_EXCEL_DOC_URL=
VITE_POWERPOINT_DOC_URL=
